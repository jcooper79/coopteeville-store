{
  "name": "coopteeville-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create coopteeville",
    "db:migrate:local": "wrangler d1 migrations apply coopteeville --local",
    "db:migrate": "wrangler d1 migrations apply coopteeville --remote",
    "typecheck": "tsc --noEmit",
    "check:print": "node scripts/check-print-file.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
