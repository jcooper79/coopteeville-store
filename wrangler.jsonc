{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coopteeville-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Static storefront from ./public; the Worker only runs for /api/*.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "coopteeville", "database_id": "REPLACE_AFTER_wrangler_d1_create", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SITE_URL": "https://coopteeville.com",
    // true = paid orders go straight to production at Printful (hands-off fulfillment).
    "PRINTFUL_AUTO_CONFIRM": "true",
    // false = plate orders wait as Printful drafts for a quick review. Flip to true once the AI plate check ships.
    "PLATE_AUTO_APPROVE": "false",
    "EMAIL_FROM": "Coopteeville <orders@coopteeville.com>"
  },
  "observability": { "enabled": true }
}
