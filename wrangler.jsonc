{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coopteeville-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Static storefront from ./public; the Worker only runs for /api/*.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "coopteeville", "database_id": "REPLACE_AFTER_wrangler_d1_create", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SITE_URL": "https://coopteeville.com",
    // false = Printful orders land as drafts for a human check. Flip to true after launch QA.
    "PRINTFUL_AUTO_CONFIRM": "false"
  },
  "observability": { "enabled": true }
}
