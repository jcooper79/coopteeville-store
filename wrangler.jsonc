{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coopteeville-store",
  "account_id": "712e38517a7e6baf08301e3202ca5da8",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Storefront files are bundled into the Worker (see src/static.ts).
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.svg", "**/*.txt"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "coopteeville", "database_id": "60af6145-c51a-4f29-b4ba-59f3670902a1", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SITE_URL": "https://coopteeville.com",
    // true = paid orders go straight to production at Printful (hands-off fulfillment).
    "PRINTFUL_AUTO_CONFIRM": "true",
    // false = plate orders wait as Printful drafts for a quick review. Flip to true once the AI plate check ships.
    "PLATE_AUTO_APPROVE": "false",
    "EMAIL_FROM": "Coopteeville Pit Crew <glovebox@coopteeville.com>"
  },
  // Serve the store on the apex and www. Cloudflare creates and manages the DNS records.
  "routes": [
    { "pattern": "coopteeville.com", "custom_domain": true },
    { "pattern": "www.coopteeville.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
